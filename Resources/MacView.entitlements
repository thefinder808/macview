<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Direct (Developer ID) distribution, not the App Store. Sandbox off so
         the viewer can read sibling files in the same folder for Next/Previous
         paging without a security-scoped bookmark dance. Matches the fleet. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
